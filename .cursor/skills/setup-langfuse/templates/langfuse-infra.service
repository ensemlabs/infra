[Unit]
Description=Langfuse (infra Docker)
Requires=docker-infra.service minio-infra.service
After=docker-infra.service minio-infra.service
StartLimitIntervalSec=0

[Service]
Type=oneshot
RemainAfterExit=yes
Environment=DOCKER_HOST=unix:///run/docker-infra.sock
WorkingDirectory=__INFRA_ROOT__/langfuse
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose stop
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
