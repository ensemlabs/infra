[Unit]
Description=GitLab (infra Docker)
Requires=docker-infra.service __MOUNT_UNIT__
After=docker-infra.service __MOUNT_UNIT__
StartLimitIntervalSec=0

[Service]
Type=oneshot
RemainAfterExit=yes
Environment=DOCKER_HOST=unix:///run/docker-infra.sock
WorkingDirectory=__INFRA_ROOT__/gitlab
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose stop
TimeoutStartSec=600

[Install]
WantedBy=multi-user.target
