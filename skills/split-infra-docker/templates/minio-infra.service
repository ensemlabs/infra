[Unit]
Description=MinIO (infra Docker)
Requires=docker-infra.service
After=docker-infra.service
StartLimitIntervalSec=0

[Service]
Type=oneshot
RemainAfterExit=yes
Environment=DOCKER_HOST=unix:///run/docker-infra.sock
WorkingDirectory=__INFRA_ROOT__/minio
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose stop
TimeoutStartSec=180

[Install]
WantedBy=multi-user.target
