[Unit]
Description=Docker Engine (infra, __INFRA_ROOT__)
Documentation=https://docs.docker.com
After=network-online.target firewalld.service containerd-infra.service __MOUNT_UNIT__ time-set.target
Wants=network-online.target
Requires=containerd-infra.service __MOUNT_UNIT__
StartLimitBurst=3
StartLimitIntervalSec=60

[Service]
Type=notify
ExecStartPre=/usr/local/sbin/docker-infra-bridge.sh
ExecStart=/usr/bin/dockerd --config-file=/etc/docker/daemon-infra.json
ExecStartPost=/usr/local/sbin/docker-infra-post.sh
ExecReload=/bin/kill -s HUP $MAINPID
TimeoutStartSec=0
RestartSec=2
Restart=always
LimitNPROC=infinity
LimitCORE=infinity
TasksMax=infinity
Delegate=yes
KillMode=process
OOMScoreAdjust=-500

[Install]
WantedBy=multi-user.target
