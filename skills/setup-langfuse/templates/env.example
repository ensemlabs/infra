# ---- Network ----
BIND_ADDR=127.0.0.1
WG_ADDR=10.66.0.2
PUBLIC_HOST=0.0.0.0
LANGFUSE_PUBLIC_PORT=3100
S3_PUBLIC_PORT=9100
HOST_UID=1000
HOST_GID=1000

# ---- Database / cache ----
POSTGRES_PASSWORD=CHANGE_ME
REDIS_PASSWORD=CHANGE_ME
CLICKHOUSE_PASSWORD=CHANGE_ME

# ---- MinIO (must match minio/.env LANGFUSE_S3_*) ----
LANGFUSE_S3_ACCESS_KEY=langfuse
LANGFUSE_S3_SECRET_KEY=CHANGE_ME_copy_from_minio_env

# ---- Langfuse secrets ----
# SALT = 32 hex; ENCRYPTION_KEY and NEXTAUTH_SECRET = 64 hex. Do not rotate later.
LANGFUSE_SALT=CHANGE_ME_openssl_rand_hex_16
LANGFUSE_ENCRYPTION_KEY=CHANGE_ME_openssl_rand_hex_32
LANGFUSE_NEXTAUTH_SECRET=CHANGE_ME_openssl_rand_hex_32

# Project keys LiteLLM uses for traces (copy into litellm/.env)
LANGFUSE_PUBLIC_KEY=pk-lf-CHANGE_ME
LANGFUSE_SECRET_KEY=sk-lf-CHANGE_ME

# First-boot admin
LANGFUSE_ADMIN_EMAIL=admin@example.com
LANGFUSE_ADMIN_PASSWORD=CHANGE_ME
