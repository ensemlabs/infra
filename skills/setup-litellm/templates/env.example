# ---- Network ----
BIND_ADDR=127.0.0.1
WG_ADDR=10.66.0.2
PUBLIC_HOST=0.0.0.0
LITELLM_PUBLIC_PORT=4000

# ---- Secrets ----
POSTGRES_PASSWORD=CHANGE_ME
# Break-glass admin. Apps must use virtual keys from /ui.
LITELLM_MASTER_KEY=sk-CHANGE_ME
# Encrypts provider keys in DB. NEVER change after models are added.
LITELLM_SALT_KEY=sk-CHANGE_ME
LITELLM_UI_PASSWORD=CHANGE_ME

# Langfuse tracing (must match langfuse/.env)
LANGFUSE_PUBLIC_KEY=pk-lf-CHANGE_ME
LANGFUSE_SECRET_KEY=sk-lf-CHANGE_ME

# Optional provider key in env. Current fleet stores DeepSeek in the UI/DB.
OPENAI_API_KEY=

# Telegram alerting. One bot, one chat id per destination.
# Leave dummy values only if you also remove the webhook block from litellm_config.yaml.
TELEGRAM_BOT_TOKEN=CHANGE_ME
TELEGRAM_CHAT_PRIVATE=CHANGE_ME
TELEGRAM_CHAT_AUTOCAD=CHANGE_ME
TELEGRAM_CHAT_FENGSHUI=CHANGE_ME
